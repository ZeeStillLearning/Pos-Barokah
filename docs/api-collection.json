    {
      "name": "02 Transaksi",
      "item": [
        {
          "name": "Transaksi member tunai",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "const struk = pm.response.json().data;",
                  "pm.test('AB-1 subtotal = 101.800', function () { pm.expect(struk.subtotal).to.eql(101800); });",
                  "pm.test('AB-2 diskon grosir', function () { pm.expect(struk.diskon_grosir).to.eql(2040); });",
                  "pm.test('AB-3 diskon member', function () { pm.expect(struk.diskon_member).to.eql(2993); });",
                  "pm.test('AB-5 PPN dari DPP', function () {",
                  "    pm.expect(struk.dpp).to.eql(96767);",
                  "    pm.expect(struk.ppn).to.eql(10644);",
                  "});",
                  "pm.test('AB-6 total dibulatkan', function () {",
                  "    pm.expect(struk.total_bayar % 100).to.eql(0);",
                  "    pm.expect(struk.total_bayar).to.eql(107500);",
                  "});",
                  "pm.test('AB-7 kembalian', function () {",
                  "    pm.expect(struk.kembalian).to.eql(struk.dibayar - struk.total_bayar);",
                  "});",
                  "pm.environment.set('nomor_struk', struk.nomor);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item\": [\n    {\n      \"sku\": \"SKU-006\",\n      \"kuantitas\": 12\n    },\n    {\n      \"sku\": \"SKU-002\",\n      \"kuantitas\": 2\n    },\n    {\n      \"sku\": \"SKU-004\",\n      \"kuantitas\": 1\n    }\n  ],\n  \"member\": true,\n  \"metode_bayar\": \"tunai\",\n  \"dibayar\": 150000\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/pos/transaksi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "pos",
                "transaksi"
              ]
            }
          },
          "response": []
        },
